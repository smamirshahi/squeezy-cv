# Copy to .env (git-ignored) and fill in. Never commit the real key.
# Only the local server reads this file; secrets are never sent to the browser.

# Which AI to use for the AI assistant: "claude" (paid, best quality, default) or "ollama" (free, local)
# AI_PROVIDER=claude

# --- Claude (AI_PROVIDER=claude) ---
# Your CV text (without name/contact details) and the job advert are sent to Anthropic's API.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5; claude-haiku-5-5 is much cheaper) and timeout per call in ms
# ANTHROPIC_MODEL=
# AI_TIMEOUT_MS=120000

# --- Ollama (AI_PROVIDER=ollama) --- free, and everything stays on this computer
# 1. Install from https://ollama.com   2. ollama pull llama3.1   3. set AI_PROVIDER=ollama and restart
# OLLAMA_MODEL=llama3.1
# OLLAMA_URL=http://127.0.0.1:11434   (must be this machine)
# OLLAMA_NUM_CTX=16384   (context size; the CV and the prompt need a lot)
